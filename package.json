{
  "name": "xtwenty-cloudflare-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "cf-types": "wrangler types",
    "dev": "pnpm build:worker && wrangler dev",
    "deploy": "pnpm build:worker && wrangler deploy",
    "dry-run": "pnpm build:worker && wrangler deploy --dry-run",
    "test": "pnpm build:worker && vitest run",
    "typecheck": "pnpm build:worker && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.6",
    "@types/node": "24.6.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.130.0"
  }
}
